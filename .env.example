# ==========================================
# TypeScript / primary TripMate application
# ==========================================
# Optional. If omitted, the TypeScript app uses its deterministic fallback.
GEMINI_API_KEY=
PORT=3000

# ==========================================
# Python / LangGraph application (optional)
# ==========================================
# Required only when using the Python agent API.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# Optional for local development: the Python API falls back to in-memory
# checkpoints when DATABASE_URL is absent. Configure PostgreSQL for durable
# human-approval sessions across restarts and multiple workers.
DATABASE_URL=
PYTHON_PORT=8000
